{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Main": "Data Source=YOUR_SQL_SERVER;Initial Catalog=YOUR_DB;User ID=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "InvoiceApi",
    "Audience": "InvoiceApp",
    "SigningKey": "CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "ExpireHours": 12
  },
  "Viettel": {
    "ApiLink": "https://api-vinvoice.viettel.vn",
    "Username": "",
    "Password": "",
    "UseProxy": false,
    "ProxyHost": "",
    "ProxyPort": 0,
    "TimeoutSeconds": 60
  },
  "InvoiceDefaults": {
    "TaxCode": "",
    "TemplateCode": "1/001",
    "InvoiceSeries": "C25TBN",
    "PaymentMethod": "TM/CK"
  },
  "Smtp": {
    "Server": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "FromEmail": "",
    "EnableSsl": true,
    "AcceptAnyCertificate": false
  },
  "Cors": {
    "AllowedOrigins": [
      "*"
    ]
  },
  "Database": {
    "EnsureUsersTable": true
  },
  "Swagger": {
    "Enabled": false
  }
}